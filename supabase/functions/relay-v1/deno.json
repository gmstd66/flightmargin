{
  "imports": {
    "pg": "npm:pg@8.23.0"
  },
  "fmt": {
    "lineWidth": 88,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "tasks": {
    "check": "deno fmt --check && deno lint && deno check index.ts tests/*.ts",
    "test": "deno test --allow-env --allow-net --no-check=remote tests/"
  }
}
