{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Quota Monitor",
  "version": "__APP_VERSION__",
  "identifier": "com.codexquotamonitor.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Quota Monitor",
        "width": 760,
        "height": 620,
        "minWidth": 620,
        "minHeight": 500,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/codex-quota-backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Codex Quota Monitor"
      }
    }
  }
}
