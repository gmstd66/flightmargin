{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlightMargin",
  "version": "__APP_VERSION__",
  "identifier": "io.github.gmstd66.flightmargin",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FlightMargin",
        "width": 600,
        "height": 450,
        "minWidth": 560,
        "minHeight": 400,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src http://127.0.0.1:*; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "FlightMargin contributors",
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/codex-quota-backend"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "FlightMargin",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
